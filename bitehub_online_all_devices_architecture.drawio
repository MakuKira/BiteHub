<mxfile host="65bd71144e">
    <diagram id="online-architecture" name="1. Online architecture">
        <mxGraphModel dx="1267" dy="536" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#15354B;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;" value="BITEHUB • ONLINE INSTALLABLE-APP ARCHITECTURE" vertex="1">
                    <mxGeometry height="52" width="1820" x="30" y="22" as="geometry"/>
                </mxCell>
                <mxCell id="p1-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#426174;fontSize=17;align=left;verticalAlign=middle;" value="Proposed target: install the app on each device, then sync all roles through one secure online BiteHub service. The app is not a website tab." vertex="1">
                    <mxGeometry height="44" width="1820" x="30" y="75" as="geometry"/>
                </mxCell>
                <mxCell id="p1-client-bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4F8;strokeColor=#54849B;strokeWidth=1;dashed=1;dashPattern=6 6;opacity=35;" value="" vertex="1">
                    <mxGeometry height="720" width="470" x="30" y="140" as="geometry"/>
                </mxCell>
                <mxCell id="p1-client-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#214D62;fontSize=19;fontStyle=1;align=left;verticalAlign=middle;" value="INSTALLED BITEHUB CLIENTS" vertex="1">
                    <mxGeometry height="42" width="430" x="50" y="155" as="geometry"/>
                </mxCell>
                <mxCell id="p1-client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A8EA5;strokeWidth=1.5;fontColor=#143B52;fontSize=16;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;One app with role-based screens&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Mobile:&lt;/b&gt; iPhone / iPad • Android phones / tablets&lt;br&gt;&lt;b&gt;Desktop:&lt;/b&gt; Windows • macOS • Linux&lt;br&gt;&lt;br&gt;&lt;b&gt;Reuse the current UI:&lt;/b&gt;&lt;br&gt;Capacitor packages the existing HTML/CSS/JavaScript UI for iOS and Android.&lt;br&gt;Tauri packages the same UI for desktop installers.&lt;br&gt;&lt;br&gt;UI assets are bundled inside the app. It launches from an app icon and does not open a public website in Chrome or Safari." vertex="1">
                    <mxGeometry height="350" width="420" x="55" y="205" as="geometry"/>
                </mxCell>
                <mxCell id="p1-shell-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAFC;strokeColor=#82AABB;strokeWidth=1.5;fontColor=#29495C;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;App shell and device features&lt;/b&gt;&lt;br&gt;System WebView runs inside the installed app; it is not a browser tab. Add native permissions and plugins for secure credential storage, notifications, camera/photo access, deep links, and GPS." vertex="1">
                    <mxGeometry height="125" width="420" x="55" y="575" as="geometry"/>
                </mxCell>
                <mxCell id="p1-channel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEFF4;strokeColor=#5A8EA5;strokeWidth=1.5;fontColor=#143B52;fontSize=16;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;Install &amp; update&lt;/b&gt;&lt;br&gt;Apple App Store / TestFlight • Google Play • signed desktop installer or store" vertex="1">
                    <mxGeometry height="95" width="420" x="55" y="730" as="geometry"/>
                </mxCell>
                <mxCell id="p1-network-tag" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#D49A38;strokeWidth=1.5;fontColor=#6E4C17;fontSize=16;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;PUBLIC INTERNET&lt;/b&gt;&lt;br&gt;Apps call the API using TLS / HTTPS and JSON." vertex="1">
                    <mxGeometry height="74" width="325" x="555" y="175" as="geometry"/>
                </mxCell>
                <mxCell id="p1-online-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#D49A38;strokeWidth=1.5;fontColor=#6E4C17;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;When internet is available&lt;/b&gt;&lt;br&gt;Sign in, load the latest menu and stock, place or manage orders, receive updates, and share delivery GPS across devices.&lt;br&gt;&lt;br&gt;&lt;b&gt;When disconnected&lt;/b&gt;&lt;br&gt;The app shell can still open. Live account/order/stock/GPS actions pause. A last-viewed menu cache is optional and must be built; the server remains the source of truth." vertex="1">
                    <mxGeometry height="220" width="355" x="545" y="600" as="geometry"/>
                </mxCell>
                <mxCell id="p1-cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F7FB;strokeColor=#85A4B9;strokeWidth=2;dashed=1;dashPattern=8 8;fontColor=#31566E;fontSize=18;fontStyle=1;align=left;verticalAlign=top;spacingTop=17;spacingLeft=18;" value="BITEHUB ONLINE SERVICE LAYER  •  HOSTED CLOUD" vertex="1">
                    <mxGeometry height="735" width="645" x="930" y="135" as="geometry"/>
                </mxCell>
                <mxCell id="p1-api-domain" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F2F2;strokeColor=#338D91;strokeWidth=1.5;fontColor=#17474D;fontSize=16;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;Public HTTPS API address&lt;/b&gt;&lt;br&gt;api.bitehub.app  •  API endpoint for apps (not a user-facing website)" vertex="1">
                    <mxGeometry height="78" width="545" x="980" y="195" as="geometry"/>
                </mxCell>
                <mxCell id="p1-api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#557CB4;strokeWidth=1.5;fontColor=#253E67;fontSize=16;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;Production Python API&lt;/b&gt;&lt;br&gt;Harden or replace today’s local &lt;code&gt;server.py&lt;/code&gt; HTTP server before launch.&lt;br&gt;Authentication • role/ownership checks • menu/stock/order rules • delivery-link checks • JSON responses" vertex="1">
                    <mxGeometry height="150" width="545" x="980" y="315" as="geometry"/>
                </mxCell>
                <mxCell id="p1-db" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EA;strokeColor=#54895B;strokeWidth=1.5;fontColor=#214A2C;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;Managed PostgreSQL&lt;/b&gt;&lt;br&gt;One shared source of truth for accounts, stalls, menu, stock, orders, feedback, settings, delivery tokens, and positions.&lt;br&gt;&lt;br&gt;Private network: apps never connect directly." vertex="1">
                    <mxGeometry height="160" width="255" x="980" y="510" as="geometry"/>
                </mxCell>
                <mxCell id="p1-files" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBF8;strokeColor=#8B70B1;strokeWidth=1.5;fontColor=#433162;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;Persistent file storage&lt;/b&gt;&lt;br&gt;Menu photos and uploads stored outside the API server’s temporary filesystem.&lt;br&gt;&lt;br&gt;API checks ownership and returns safe access links." vertex="1">
                    <mxGeometry height="160" width="265" x="1260" y="510" as="geometry"/>
                </mxCell>
                <mxCell id="p1-ops" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF3F6;strokeColor=#718897;strokeWidth=1.5;fontColor=#334A58;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;Secret settings • database migrations • monitoring • backups" vertex="1">
                    <mxGeometry height="120" width="255" x="980" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="p1-push" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EB;strokeColor=#CC8161;strokeWidth=1.5;fontColor=#674031;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;API sends mobile pushes through Apple APNs / Google FCM; optional email for account notices." vertex="1">
                    <mxGeometry height="120" width="265" x="1260" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="p1-ext" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F4E9;strokeColor=#C19A48;strokeWidth=1.5;fontColor=#654E21;fontSize=16;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;Apple APNs&lt;/b&gt;&lt;br&gt;iOS push delivery&lt;br&gt;&lt;br&gt;&lt;b&gt;Google FCM&lt;/b&gt;&lt;br&gt;Android push delivery" vertex="1">
                    <mxGeometry height="160" width="235" x="1610" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="p1-ext-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#C19A48;strokeWidth=1.5;fontColor=#654E21;fontSize=14;align=left;verticalAlign=middle;spacing=14;" value="Push providers deliver alerts to the installed app. The app then fetches current order details from the BiteHub API." vertex="1">
                    <mxGeometry height="100" width="235" x="1610" y="535" as="geometry"/>
                </mxCell>
                <mxCell id="p1-e1" edge="1" parent="1" source="p1-client" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#167D8D;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.48;entryX=0;entryY=0.5;" target="p1-api-domain" value="TLS / HTTPS • JSON request and response">
