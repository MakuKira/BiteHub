                <mxCell id="p2-api-admin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8D70A9;strokeWidth=1.5;fontColor=#1E3E54;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;PYTHON API • PERMISSION + BUSINESS RULES&lt;/b&gt;&lt;br&gt;Require admin permission for every call&lt;br&gt;Record sensitive changes&lt;br&gt;Return only authorized records" vertex="1">
                    <mxGeometry height="135" width="460" x="830" y="567" as="geometry"/>
                </mxCell>
                <mxCell id="p2-data-admin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8D70A9;strokeWidth=1.5;fontColor=#1E3E54;fontSize=14;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;SHARED ONLINE DATA + RESPONSE&lt;/b&gt;&lt;br&gt;&lt;b&gt;Shared records:&lt;/b&gt; users • stalls • settings • order summaries&lt;br&gt;&lt;br&gt;Admin actions are logged and protected." vertex="1">
                    <mxGeometry height="135" width="455" x="1360" y="567" as="geometry"/>
                </mxCell>
                <mxCell id="p2-a-admin" edge="1" parent="1" source="p2-role-admin" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#718897;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p2-ui-admin" value="opens">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-b-admin" edge="1" parent="1" source="p2-ui-admin" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#167D8D;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p2-api-admin" value="HTTPS / JSON">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-c-admin" edge="1" parent="1" source="p2-api-admin" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#54895B;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p2-data-admin" value="read / write">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-bg-delivery" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#C3933A;strokeWidth=1;dashed=1;dashPattern=6 6;opacity=35;" value="" vertex="1">
                    <mxGeometry height="180" width="1825" x="30" y="745" as="geometry"/>
                </mxCell>
                <mxCell id="p2-role-delivery" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3933A;strokeWidth=1.5;fontColor=#1E3E54;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;4  DELIVERY TRACKING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Runner does not need a BiteHub login" vertex="1">
                    <mxGeometry height="135" width="240" x="50" y="767" as="geometry"/>
                </mxCell>
                <mxCell id="p2-ui-delivery" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3933A;strokeWidth=1.5;fontColor=#1E3E54;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;IN THE INSTALLED APP&lt;/b&gt;&lt;br&gt;Owner shares an order-specific expiring link&lt;br&gt;Runner taps the app link and grants GPS permission&lt;br&gt;Installed app sends location while delivery is active" vertex="1">
                    <mxGeometry height="135" width="440" x="320" y="767" as="geometry"/>
                </mxCell>
                <mxCell id="p2-api-delivery" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3933A;strokeWidth=1.5;fontColor=#1E3E54;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;PYTHON API • PERMISSION + BUSINESS RULES&lt;/b&gt;&lt;br&gt;Verify link token, order, and expiry&lt;br&gt;Accept location only while authorized&lt;br&gt;Return current position to buyer and owner" vertex="1">
                    <mxGeometry height="135" width="460" x="830" y="767" as="geometry"/>
                </mxCell>
                <mxCell id="p2-data-delivery" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C3933A;strokeWidth=1.5;fontColor=#1E3E54;fontSize=14;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;SHARED ONLINE DATA + RESPONSE&lt;/b&gt;&lt;br&gt;&lt;b&gt;Shared records:&lt;/b&gt; token hash • expiry • delivery positions • order status&lt;br&gt;&lt;br&gt;When finished, expire the token and stop location sharing." vertex="1">
                    <mxGeometry height="135" width="455" x="1360" y="767" as="geometry"/>
                </mxCell>
                <mxCell id="p2-a-delivery" edge="1" parent="1" source="p2-role-delivery" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#718897;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p2-ui-delivery" value="opens">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-b-delivery" edge="1" parent="1" source="p2-ui-delivery" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#167D8D;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p2-api-delivery" value="HTTPS / JSON">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-c-delivery" edge="1" parent="1" source="p2-api-delivery" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#54895B;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p2-data-delivery" value="read / write">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p2-foot" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#31566E;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" value="All devices share the same backend. Changes made by a stall owner appear in customers’ apps after the API returns fresh data." vertex="1">
                    <mxGeometry height="32" width="1800" x="35" y="940" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="transformation-roadmap" name="3. Transformation plan">
        <mxGraphModel dx="2249" dy="951" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="p3-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#15354B;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;" value="BITEHUB • TRANSFORMATION AND RELEASE PLAN" vertex="1">
                    <mxGeometry height="52" width="1820" x="30" y="22" as="geometry"/>
                </mxCell>
                <mxCell id="p3-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#426174;fontSize=17;align=left;verticalAlign=middle;" value="A practical path from today’s VS Code project to signed apps for phones, tablets, and computers, backed by one production service." vertex="1">
                    <mxGeometry height="42" width="1820" x="30" y="75" as="geometry"/>
                </mxCell>
                <mxCell id="p3-step1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4F8;strokeColor=#54849B;strokeWidth=1.5;fontColor=#173E54;fontSize=16;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;STEP 1 • KEEP THE EXISTING PRODUCT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reuse and audit:&lt;br&gt;&lt;code&gt;index.html&lt;/code&gt; • &lt;code&gt;app.js&lt;/code&gt; • CSS • images / campus map&lt;br&gt;&lt;br&gt;Preserve the current customer, stall-owner, admin, ordering, pickup/delivery, and tracking flows." vertex="1">
                    <mxGeometry height="215" width="390" x="35" y="145" as="geometry"/>
                </mxCell>
                <mxCell id="p3-step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF4FB;strokeColor=#577FA9;strokeWidth=1.5;fontColor=#253E67;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;STEP 2 • PREPARE THE CLIENT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Separate the API client from screen code.&lt;br&gt;Set one HTTPS API base URL per environment.&lt;br&gt;Add a production build folder, app icons, safe-area layout, deep links, and permission screens.&lt;br&gt;Use secure device storage for credentials." vertex="1">
                    <mxGeometry height="215" width="410" x="465" y="145" as="geometry"/>
                </mxCell>
                <mxCell id="p3-step3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EA;strokeColor=#54895B;strokeWidth=1.5;fontColor=#214A2C;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;STEP 3 • PACKAGE FOR DEVICES (RECOMMENDED REUSE PATH)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Capacitor:&lt;/b&gt; iOS + Android apps from the current JavaScript UI.&lt;br&gt;&lt;b&gt;Tauri:&lt;/b&gt; Windows + macOS + Linux desktop installers from the same UI.&lt;br&gt;&lt;br&gt;The OS web view is inside the signed app. Users launch the app; they do not navigate to a website." vertex="1">
                    <mxGeometry height="215" width="445" x="915" y="145" as="geometry"/>
                </mxCell>
                <mxCell id="p3-step4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EB;strokeColor=#CC8161;strokeWidth=1.5;fontColor=#674031;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;STEP 4 • TEST, SIGN, PUBLISH&lt;/b&gt;&lt;br&gt;&lt;br&gt;Test on real phones, tablets, and computers with each role.&lt;br&gt;&lt;br&gt;iOS: Xcode build → TestFlight → App Store&lt;br&gt;Android: signed AAB/APK → Play Console&lt;br&gt;Desktop: signed installer / store packages" vertex="1">
                    <mxGeometry height="215" width="445" x="1400" y="145" as="geometry"/>
                </mxCell>
                <mxCell id="p3-flow1" edge="1" parent="1" source="p3-step1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#718897;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p3-step2" value="audit &amp; split">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-flow2" edge="1" parent="1" source="p3-step2" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#167D8D;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p3-step3" value="build packages">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-flow3" edge="1" parent="1" source="p3-step3" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#CC8161;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p3-step4" value="release builds">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-backend-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8A4B38;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" value="BACKEND TRANSFORMATION • CURRENT SERVER IS A LOCAL PROTOTYPE; MAKE IT PRODUCTION-READY BEFORE REAL USERS" vertex="1">
                    <mxGeometry height="42" width="1810" x="35" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="p3-current" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6F2;strokeColor=#CC8161;strokeWidth=1.5;fontColor=#674031;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;TODAY&lt;/b&gt;&lt;br&gt;&lt;code&gt;server.py&lt;/code&gt; uses Python’s built-in &lt;code&gt;ThreadingHTTPServer&lt;/code&gt; and SQLite.&lt;br&gt;&lt;br&gt;&lt;code&gt;render.yaml&lt;/code&gt; can deploy a prototype, but this built-in server + local SQLite is not the production target for internet-facing student accounts and orders." vertex="1">
                    <mxGeometry height="205" width="390" x="35" y="465" as="geometry"/>
                </mxCell>
                <mxCell id="p3-api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FA;strokeColor=#557CB4;strokeWidth=1.5;fontColor=#253E67;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;PRODUCTION API&lt;/b&gt;&lt;br&gt;Keep the existing API behavior and migrate it to a supported production ASGI/WSGI server.&lt;br&gt;&lt;br&gt;Add HTTPS, secure authentication, role and ownership checks, rate limits, health checks, migrations, monitoring, and secret management." vertex="1">
                    <mxGeometry height="205" width="410" x="465" y="465" as="geometry"/>
                </mxCell>
                <mxCell id="p3-data" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F5EA;strokeColor=#54895B;strokeWidth=1.5;fontColor=#214A2C;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;PERSISTENT CLOUD DATA&lt;/b&gt;&lt;br&gt;Move SQLite records to managed PostgreSQL.&lt;br&gt;Put menu photos in persistent object/file storage.&lt;br&gt;&lt;br&gt;Database is reachable by the API service only. Set up backup/restore and a migration plan before launch." vertex="1">
                    <mxGeometry height="205" width="445" x="915" y="465" as="geometry"/>
                </mxCell>
                <mxCell id="p3-host" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0EBF8;strokeColor=#8B70B1;strokeWidth=1.5;fontColor=#433162;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;HOSTED SERVICES&lt;/b&gt;&lt;br&gt;Host the Python API on Render or an equivalent provider.&lt;br&gt;Use one HTTPS API domain; keep database private to the API.&lt;br&gt;&lt;br&gt;Apps use the same production API, so accounts, menus, orders, and live status stay synchronized across devices." vertex="1">
                    <mxGeometry height="205" width="445" x="1400" y="465" as="geometry"/>
                </mxCell>
                <mxCell id="p3-back1" edge="1" parent="1" source="p3-current" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#557CB4;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p3-api" value="harden / migrate">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-back2" edge="1" parent="1" source="p3-api" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#54895B;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p3-data" value="persist / migrate data">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-back3" edge="1" parent="1" source="p3-data" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#8B70B1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p3-host" value="deploy securely">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p3-native-option" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F1FA;strokeColor=#8B70B1;strokeWidth=1.5;fontColor=#433162;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;IF “NO BROWSER” MEANS “NO EMBEDDED WEB VIEW”&lt;/b&gt;&lt;br&gt;Choose a full UI rewrite in Flutter (Dart) for Android, iOS, Windows, macOS, and Linux. Keep the Python API and database architecture above. This gives a more native-rendered UI, but all existing screens and interactions must be rebuilt and checked." vertex="1">
                    <mxGeometry height="145" width="885" x="35" y="725" as="geometry"/>
                </mxCell>
                <mxCell id="p3-practical" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#D49A38;strokeWidth=1.5;fontColor=#6E4C17;fontSize=15;align=left;verticalAlign=middle;spacing=14;" value="&lt;b&gt;ONLINE APP EXPECTATION&lt;/b&gt;&lt;br&gt;Installing and opening BiteHub is an app experience, but signing in, loading current data, placing orders, changing stock, receiving live status, and sharing GPS need internet. Cache can support limited read-only viewing; queued or real-time actions need an online API." vertex="1">
                    <mxGeometry height="145" width="885" x="960" y="725" as="geometry"/>
                </mxCell>
                <mxCell id="p3-iosnote" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#31566E;fontSize=16;align=left;verticalAlign=middle;" value="Build setup note: Apple iOS builds use Xcode on macOS (or a managed cloud build service). Release tracks, developer accounts, signing, store review, and updates are separate steps for each platform." vertex="1">
                    <mxGeometry height="48" width="1810" x="35" y="890" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>