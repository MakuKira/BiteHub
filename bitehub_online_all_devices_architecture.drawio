                <mxCell id="p1-e2" edge="1" parent="1" source="p1-api-domain" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#557CB4;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="p1-api" value="route requests">
