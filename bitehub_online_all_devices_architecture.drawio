                <mxCell id="p1-e3" edge="1" parent="1" source="p1-api" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#54895B;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" target="p1-db" value="read / write">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1-e4" edge="1" parent="1" source="p1-api" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#8B70B1;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=0.78;exitY=1;entryX=0.5;entryY=0;" target="p1-files" value="upload / retrieve">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1-e5" edge="1" parent="1" source="p1-api" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#718897;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" target="p1-ops" value="logs / health">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1-e6" edge="1" parent="1" source="p1-api" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#CC8161;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" target="p1-push" value="send push">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1-e7" edge="1" parent="1" source="p1-push" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;strokeColor=#C19A48;strokeWidth=2;endArrow=block;endFill=1;fontSize=13;fontColor=#243746;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="p1-ext" value="APNs / FCM">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="p1-footer" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#31566E;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" value="Key idea: accounts, menus, stock, orders, and tracking stay on one online backend so a phone and computer see the same BiteHub data." vertex="1">
                    <mxGeometry height="48" width="1815" x="30" y="890" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="role-flows" name="2. Role workflows">
