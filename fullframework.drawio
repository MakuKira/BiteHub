  <diagram id="bitehub-full-framework" name="BiteHub Full Framework">
    <mxGraphModel dx="1640" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="BITEHUB · FULL FRAMEWORK FLOW" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#20384d;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="780" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="3 campus sign-in paths + restricted administrator access · browser → Python API → SQLite → role-specific updates" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#617486;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1120" height="30" as="geometry"/></mxCell>
        <mxCell id="entry" value="&lt;b&gt;BROWSER / START&lt;/b&gt;&lt;br&gt;BiteHub landing page&lt;br&gt;Sign in or create account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#20384d;fontColor=#ffffff;strokeColor=#20384d;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="180" height="100" as="geometry"/></mxCell>

        <mxCell id="buyerAuth" value="&lt;b&gt;CUSTOMER LOGIN / SIGNUP&lt;/b&gt;&lt;br&gt;Public account · buyer role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf5ff;fontColor=#20384d;strokeColor=#8eb5df;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="150" width="230" height="72" as="geometry"/></mxCell>
        <mxCell id="ownerAuth" value="&lt;b&gt;STALL OWNER LOGIN / SIGNUP&lt;/b&gt;&lt;br&gt;Public account · owner role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e9;fontColor=#20384d;strokeColor=#e6aa73;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="360" width="230" height="72" as="geometry"/></mxCell>
        <mxCell id="runnerAuth" value="&lt;b&gt;CAMPUS RUNNER LOGIN / SIGNUP&lt;/b&gt;&lt;br&gt;Public account · runner role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf6f5;fontColor=#20384d;strokeColor=#78b8b5;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="570" width="230" height="72" as="geometry"/></mxCell>
        <mxCell id="adminAuth" value="&lt;b&gt;ADMINISTRATOR LOGIN&lt;/b&gt;&lt;br&gt;Restricted · no public signup&lt;br&gt;Account created from server CLI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf7f0;fontColor=#20384d;strokeColor=#82bd96;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="780" width="230" height="82" as="geometry"/></mxCell>

        <mxCell id="buyerUI" value="&lt;b&gt;CUSTOMER EXPERIENCE&lt;/b&gt;&lt;br&gt;Browse/filter menu · view stall hours&lt;br&gt;Cart → choose pickup slot or delivery&lt;br&gt;Place order · track status · submit review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7fbff;fontColor=#20384d;strokeColor=#8eb5df;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="565" y="130" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="ownerUI" value="&lt;b&gt;STALL OWNER WORKSPACE&lt;/b&gt;&lt;br&gt;Create/edit menu · stock · dietary/allergens&lt;br&gt;Set opening hours, prep time, slot capacity&lt;br&gt;Accept/decline → prepare → ready&lt;br&gt;Assign delivery runner · read feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf5;fontColor=#20384d;strokeColor=#e6aa73;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="565" y="330" width="280" height="132" as="geometry"/></mxCell>
        <mxCell id="runnerUI" value="&lt;b&gt;RUNNER WORKSPACE&lt;/b&gt;&lt;br&gt;See assigned delivery runs&lt;br&gt;Ready → picked up / out → delivered&lt;br&gt;Only assigned orders are actionable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5fbfa;fontColor=#20384d;strokeColor=#78b8b5;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="565" y="550" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="adminUI" value="&lt;b&gt;ADMIN WORKSPACE&lt;/b&gt;&lt;br&gt;Approve/pause stalls · pause/resume ordering&lt;br&gt;Review campus orders and activity totals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5fbf6;fontColor=#20384d;strokeColor=#82bd96;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="565" y="770" width="280" height="92" as="geometry"/></mxCell>

        <mxCell id="api" value="&lt;b&gt;PYTHON SERVER · server.py&lt;/b&gt;&lt;br&gt;HTTP API + role/ownership checks&lt;br&gt;Password hashing · session lookup&lt;br&gt;Validates orders, stock, hours, capacity&lt;br&gt;Applies order status transitions&lt;br&gt;Serves app.js, HTML, CSS, logo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f0f5;fontColor=#20384d;strokeColor=#3168a7;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="930" y="385" width="270" height="210" as="geometry"/></mxCell>
        <mxCell id="db" value="&lt;b&gt;SQLITE DATABASE&lt;/b&gt;&lt;br&gt;bitehub.sqlite3 · WAL mode&lt;br&gt;&lt;br&gt;&lt;b&gt;users&lt;/b&gt; · salted password hashes · roles&lt;br&gt;&lt;b&gt;sessions&lt;/b&gt; · hashed token · expiry&lt;br&gt;&lt;b&gt;stalls&lt;/b&gt; · approval · hours · capacity&lt;br&gt;&lt;b&gt;products&lt;/b&gt; · prices · stock · food tags&lt;br&gt;&lt;b&gt;orders / order_items&lt;/b&gt; · status · totals&lt;br&gt;&lt;b&gt;feedback&lt;/b&gt; · ratings · comments&lt;br&gt;&lt;b&gt;settings&lt;/b&gt; · global ordering pause" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff7df;fontColor=#20384d;strokeColor=#d1a83e;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="1290" y="330" width="330" height="330" as="geometry"/></mxCell>
        <mxCell id="rules" value="&lt;b&gt;CORE DATA RULES&lt;/b&gt;&lt;br&gt;• Buyer orders one stall per order&lt;br&gt;• Stock reserved at checkout&lt;br&gt;• Pickup slot capacity checked on server&lt;br&gt;• Stall must be approved, open, and available&lt;br&gt;• Owner can update only their stall/orders&lt;br&gt;• Runner can advance only assigned delivery&lt;br&gt;• Admin actions require admin role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#40596c;strokeColor=#cbd9df;fontSize=12;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="930" y="700" width="690" height="155" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;FLOW KEY&lt;/b&gt;  &lt;font color='#3168a7'&gt;━━&gt; API request / data write&lt;/font&gt;     &lt;font color='#738797'&gt;┄┄&gt; response / refreshed view&lt;/font&gt;     &lt;font color='#167a61'&gt;Role access is enforced by the server&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafb;fontColor=#40596c;strokeColor=#d9e4e7;fontSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="900" height="50" as="geometry"/></mxCell>

